# Copia este archivo como .env en el servidor.
# No subas el .env real a GitHub.

# === URL pública ===
# Sin dominio:
# MAIN_URL=http://IP_DEL_SERVIDOR:4007
# FRONTEND_URL=http://IP_DEL_SERVIDOR:4007
# NEXT_PUBLIC_BACKEND_URL=http://IP_DEL_SERVIDOR:4007/api
#
# Con dominio y proxy HTTPS:
# MAIN_URL=https://postiz.tudominio.com
# FRONTEND_URL=https://postiz.tudominio.com
# NEXT_PUBLIC_BACKEND_URL=https://postiz.tudominio.com/api
MAIN_URL=http://IP_DEL_SERVIDOR:4007
FRONTEND_URL=http://IP_DEL_SERVIDOR:4007
NEXT_PUBLIC_BACKEND_URL=http://IP_DEL_SERVIDOR:4007/api
BACKEND_INTERNAL_URL=http://localhost:3000
POSTIZ_PORT=4007
NEXT_PUBLIC_VERSION=local

# === Secretos obligatorios ===
# Genera JWT_SECRET con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# === PostgreSQL de Postiz ===
POSTIZ_POSTGRES_VERSION=16-alpine
POSTIZ_POSTGRES_USER=postiz-user
POSTIZ_POSTGRES_PASSWORD=cambia_esta_password
POSTIZ_POSTGRES_DB=postiz-db-local

# === Temporal ===
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=cambia_esta_password_temporal
TEMPORAL_UI_PORT=8080
TEMPORAL_CORS_ORIGINS=http://127.0.0.1:3000

# === Ajustes generales ===
IS_GENERAL=true
DISABLE_REGISTRATION=false
RUN_CRON=true
STORAGE_PROVIDER=local
API_LIMIT=30
FEE_AMOUNT=0.05
NX_ADD_PLUGINS=false

# === Social Media API Settings ===
X_URL=
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BEEHIIVE_API_KEY=
BEEHIIVE_PUBLICATION_ID=
LISTMONK_DOMAIN=
LISTMONK_USER=
LISTMONK_API_KEY=
LISTMONK_LIST_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
EXTENSION_ID=

# === Cloudflare R2, opcional ===
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=
CLOUDFLARE_BUCKET_URL=
CLOUDFLARE_REGION=auto

# === OAuth genérico, opcional ===
NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=
NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=
POSTIZ_GENERIC_OAUTH=false
POSTIZ_OAUTH_URL=
POSTIZ_OAUTH_AUTH_URL=
POSTIZ_OAUTH_TOKEN_URL=
POSTIZ_OAUTH_USERINFO_URL=
POSTIZ_OAUTH_CLIENT_ID=
POSTIZ_OAUTH_CLIENT_SECRET=
POSTIZ_OAUTH_SCOPE=

# === Email, opcional ===
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# === Misc ===
OPENAI_API_KEY=
NEXT_PUBLIC_DISCORD_SUPPORT=
NEXT_PUBLIC_POLOTNO=

# === Stripe, opcional ===
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=
STRIPE_SIGNING_KEY_CONNECT=
